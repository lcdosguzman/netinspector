# Backend
# Optional path for the local SQLite scan history database.
# Defaults to .lansweepgo/lansweepgo.db when empty.
LANSWEEPGO_DB_PATH=.lansweepgo/lansweepgo.db

# Dashboard
# Public URL used by the Next.js dashboard to reach the LanSweepGo API.
NEXT_PUBLIC_LANSWEEPGO_API_URL=http://127.0.0.1:8088

# Local development shortcuts used by the Makefile.
API_ADDR=127.0.0.1:8088
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=3000
